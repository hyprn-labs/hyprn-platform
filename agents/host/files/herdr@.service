[Unit]
Description=hyprn agents: herdr server for %i
After=network-online.target hyprn-agents-egress.service hyprn-agent-secrets@%i.service user@.service
Wants=network-online.target hyprn-agent-secrets@%i.service
Requires=hyprn-agents-egress.service

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=~
ExecStart=/usr/local/libexec/herdr-session
ExecStop=/usr/local/lib/herdr/herdr server stop
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
