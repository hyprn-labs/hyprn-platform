[Unit]
Description=hyprn agents: load runtime secrets for %i
After=network-online.target hyprn-agents-egress.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/hyprn-agent-secrets %i
ExecStopPost=/bin/rm -rf /run/hyprn-agents/secrets/%i

[Install]
WantedBy=multi-user.target
