{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "enabled_providers": ["opencode"],
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "external_directory": {
      "*": "allow",
      "/run/hyprn-agents/**": "deny"
    },
    "bash": {
      "*": "allow",
      "git push * main": "deny",
      "git push * main *": "deny",
      "git push *:main*": "deny",
      "git push *+*": "deny",
      "git push *--force*": "deny",
      "git push -f*": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "gh pr merge*": "deny",
      "gh api *": "ask",
      "git config --global*": "deny"
    }
  }
}
