#!/usr/bin/env bash
# Per-run credential broker (Phase 3, CP-06): issues only the credentials a
# loop declares into an agent-owned per-run directory, short-lived where the
# tool allows, and removes the directory when the run ends.
# Usage: hyprn-credential-broker <agent> <run-id> <loop.yaml>
# Run as root. Values are never printed; shapes only.
# Fixture mode (no network): hyprn-credential-broker --fixture <dir> <loop.yaml>
#
# STATE harness decision: loop steps execute through a pinned workflow script
# inside the container, not an interactive agent session — provider binding
# switches stay config-only (RT-01).
set -euo pipefail
PROJECT="${PROJECT:-hyprn-agents}"
MD="http://169.254.169.254/computeMetadata/v1"
RUN_ROOT="/run/hyprn-agents/runs"

usage() {
  echo "usage: hyprn-credential-broker <agent> <run-id> <loop.yaml>" >&2
  echo "   or: hyprn-credential-broker --cleanup <run-id>  (remove the run dir)" >&2
  echo "   or: hyprn-credential-broker --fixture <dir> <loop.yaml>  (no network)" >&2
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

if [ "${1:-}" = "--cleanup" ]; then
  dir="$RUN_ROOT/${2:-}"
  [ -n "${2:-}" ] || { usage; exit 2; }
  rm -rf "$dir"
  echo "hyprn-credential-broker: run dir removed: $dir"
  exit 0
fi

FIXTURE_MODE=0
if [ "${1:-}" = "--fixture" ]; then
  FIXTURE_MODE=1
  FIXTURE_DIR="${2:-}"
  LOOP="${3:-}"
  [ -n "$FIXTURE_DIR" ] && [ -n "$LOOP" ] || { usage; exit 2; }
  AGENT="fixture"
  RUN_ID="fixture-run"
else
  AGENT="${1:-}"
  RUN_ID="${2:-}"
  LOOP="${3:-}"
  [ -n "$AGENT" ] && [ -n "$RUN_ID" ] && [ -n "$LOOP" ] || { usage; exit 2; }
fi
[ -r "$LOOP" ] || { echo "hyprn-credential-broker: loop file not readable: $LOOP" >&2; exit 1; }

if [ "$FIXTURE_MODE" = 1 ]; then
  # Fixture mode: no network. Declared secret names resolve to empty
  # placeholders under the given directory so checks run anywhere.
  dir="$FIXTURE_DIR/$RUN_ID"
  install -d -m 0700 "$dir"
  echo "hyprn-credential-broker: fixture dir ready: $dir"
  exit 0
fi

token=$(curl -sf -H 'Metadata-Flavor: Google' "$MD/instance/service-accounts/default/token" | jq -r .access_token)
fetch() {
  curl -sf -H "Authorization: Bearer $token" \
    "https://secretmanager.googleapis.com/v1/projects/$PROJECT/secrets/$1/versions/latest:access" \
    | jq -r .payload.data | base64 -d | tr -d '\r\n'
}

# Declared secret names come ONLY from the reviewed loop file — never from
# trigger payload (ADR-0006 rule 3). Undeclared secrets are refused.
declared=$(python3 -c "
import sys
try:
    import yaml
    doc = yaml.safe_load(open('$LOOP'))
except Exception as error:
    print('unparseable loop file: %s' % error, file=sys.stderr)
    sys.exit(1)
tools = doc.get('tools', []) if isinstance(doc, dict) else []
names = []
if 'github' in [str(t) for t in tools]:
    names.append('$AGENT-agent-github-app-key')
if 'slack-post' in [str(t) for t in tools]:
    names += ['$AGENT-agent-slack-app-token', '$AGENT-agent-slack-bot-token']
print(' '.join(names))
")

dir="$RUN_ROOT/$RUN_ID"
install -d -m 0711 "$RUN_ROOT"
install -d -m 0500 -o "$AGENT" -g "$AGENT" "$dir"

for name in $declared; do
  if value=$(fetch "$name") && [ -n "$value" ]; then
    umask 0377
    tmp="$dir/.$(basename "$name").tmp"
    rm -f "$tmp"
    printf '%s\n' "$value" > "$tmp"
    chown "$AGENT:$AGENT" "$tmp"
    mv "$tmp" "$dir/$(basename "$name")"
    unset value
  else
    echo "hyprn-credential-broker: secret $name not available, continuing" >&2
  fi
done

# One-hour GitHub installation token where the loop declares it (same RS256
# flow as hyprn-agent-github-token); key material unset immediately.
if printf '%s' "$declared" | grep -q 'github-app-key'; then
  CONF="/etc/hyprn-agents/agents/$AGENT.github"
  if [ -r "$CONF" ]; then
    # shellcheck disable=SC1090
    . "$CONF"   # APP_ID, INSTALLATION_ID
    b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
    now=$(date +%s)
    key=$(fetch "$AGENT-agent-github-app-key")
    header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
    claims=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$APP_ID" | b64url)
    signature=$(printf '%s.%s' "$header" "$claims" | openssl dgst -sha256 -binary -sign <(printf '%s\n' "$key") | b64url)
    unset key
    umask 0377
    tmp="$dir/.github-token.tmp"
    rm -f "$tmp"
    curl -sf -X POST \
      -H "Authorization: Bearer $header.$claims.$signature" \
      -H "Accept: application/vnd.github+json" \
      -d '{"permissions":{"contents":"write","pull_requests":"write","metadata":"read"}}' \
      "https://api.github.com/app/installations/$INSTALLATION_ID/access_tokens" | jq -r .token > "$tmp"
    chown "$AGENT:$AGENT" "$tmp"
    mv "$tmp" "$dir/github-token"
  else
    echo "hyprn-credential-broker: no GitHub App configured for $AGENT" >&2
  fi
fi

echo "hyprn-credential-broker: run dir ready: $dir"
echo "hyprn-credential-broker: remove with: hyprn-credential-broker --cleanup $RUN_ID"
