#!/usr/bin/env bash
# OpenCode only for agents whose harness is opencode (agents/host/agents.txt);
# the organization policy is the root-owned /etc/opencode/opencode.json.
harness="$(cat "/etc/hyprn-agents/agents/$(id -un).harness" 2>/dev/null)"
[ "$harness" = opencode ] || { echo "opencode: not $(id -un)'s harness" >&2; exit 1; }
exec /usr/local/lib/opencode/opencode "$@"
