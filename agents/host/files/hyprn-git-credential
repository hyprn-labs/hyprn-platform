#!/usr/bin/env bash
# Git credential helper for agent users: answers for github.com with the
# agent's token from the root-written tmpfs file; stores nothing.
[ "$1" = get ] || exit 0
token_file="/run/hyprn-agents/secrets/$(id -un)/github-token"
host=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  [ "$key" = host ] && host="$value"
done
[ "$host" = github.com ] && [ -r "$token_file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$token_file")"
