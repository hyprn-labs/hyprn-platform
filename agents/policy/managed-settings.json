{
  "channelsEnabled": true,
  "allowedChannelPlugins": [
    { "marketplace": "hyprn-agents", "plugin": "slack" }
  ],
  "strictKnownMarketplaces": [
    { "source": "directory", "path": "/opt/hyprn-agents/marketplace" },
    { "source": "github", "repo": "anthropics/claude-plugins-official" },
    { "source": "skills-dir" }
  ],
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push *+*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git -C * push *)",
      "Bash(git -c * push *)",
      "Bash(gh pr merge *)",
      "Bash(gh * pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *protection*)"
    ]
  }
}
