{
  "$comment": "Claude Code organization policy, reviewed copy (D-02). The Team Owner applies this file verbatim in the admin console; the console enforces it. Deny rules are the interim main-branch control until the Team-plan ruleset (D-01). Bash patterns match command text literally, so every refusal family carries spelling variants plus live refusal tests (D-08). Phase 2 COK-02: seat panes report their lifecycle to the host herdr server (report-agent family, allowlisted); agent-to-agent prompting via `herdr agent prompt` is denied (locked, waits on Anthropic).",
  "permissions": {
    "deny": [
      "Bash(git push *main*)",
      "Bash(git push *:main*)",
      "Bash(git push *+*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git -C * push *)",
      "Bash(gh pr merge*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh api repos/*/branches/main/protection*)",
      "Bash(gh api *merge*)",
      "Bash(herdr agent prompt*)"
    ],
    "ask": [
      "Bash(gh api *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git checkout -b *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(herdr pane report-agent*)",
      "Bash(herdr pane report-agent-session*)",
      "Bash(herdr pane release-agent*)",
      "Bash(herdr status*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedPermissionRulesOnly": true,
  "strictKnownMarketplaces": [
    {
      "source": "github",
      "repo": "hyprn-labs/hyprn-agents"
    }
  ],
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "api.anthropic.com",
        "registry.npmjs.org"
      ],
      "allowManagedDomainsOnly": true
    }
  },
  "requiredMinimumVersion": "2.1.282"
}
